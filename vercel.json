{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/tg-mini-app build",
  "outputDirectory": "artifacts/tg-mini-app/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/|assets/|favicon.png|apple-touch-icon.png|animation.json|robots.txt).*)", "destination": "/index.html" }
  ]
}
